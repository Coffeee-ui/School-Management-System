# Apex Institute Frontend Environment (Example)
# Copy to .env and adjust as needed.

# Set to 'demo' to enable demo mode (auto-seed + demo presets on login page)
# Set to 'normal' for standard institutional operation
VITE_APP_MODE=normal

# API Base URL (leave as /api to use Vite dev proxy to localhost:5000)
VITE_API_URL=/api
